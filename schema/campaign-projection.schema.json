{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-coordinator/schema/campaign-projection.schema.json",
  "title": "Read-only campaign projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at", "tasks", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "tasks": {"type": "array", "items": {"type": "object"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "sessions", "by_status", "recovery_required"],
      "properties": {
        "tasks": {"type": "integer", "minimum": 0},
        "sessions": {"type": "integer", "minimum": 0},
        "by_status": {"type": "object"},
        "recovery_required": {"type": "integer", "minimum": 0}
      }
    }
  }
}
