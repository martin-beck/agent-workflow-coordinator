#!/usr/bin/env bash
# Public-safe release signer contract template. Rendering and --self-test are
# non-publishing; no-argument execution is reserved for an authorized signer.
set -euo pipefail
readonly RELEASE_VERSION="@RELEASE_VERSION@"
readonly SOURCE_COMMIT="@SOURCE_COMMIT@"
readonly REPOSITORY="@REPOSITORY@"
readonly FROM_TAG="@FROM_TAG@"
readonly TO_TAG="@TO_TAG@"
readonly TRUST_POLICY="@TRUST_POLICY@"
readonly VENDOR_MANIFEST="@VENDOR_MANIFEST@"
readonly OUTPUT="@OUTPUT@"
if [[ "${1:-}" != "--self-test" ]]; then
    [[ "$#" -eq 0 ]] || { echo "usage: $0 [--self-test]" >&2; exit 64; }
    git -C "$REPOSITORY" diff --quiet
    git -C "$REPOSITORY" diff --cached --quiet
    git -C "$REPOSITORY" commit -S --allow-empty -m "Release $RELEASE_VERSION"
    source_commit="$(git -C "$REPOSITORY" rev-parse HEAD)"
    git -C "$REPOSITORY" tag -s "${TO_TAG#refs/tags/}" -m "Release $RELEASE_VERSION" "$source_commit"
    git -C "$REPOSITORY" verify-tag "${TO_TAG#refs/tags/}"
    printf '%s\n' "repository=$REPOSITORY" "from=$FROM_TAG" "to=$TO_TAG" \
        "source_commit=$source_commit" "trust_policy=$TRUST_POLICY" \
        "vendor_manifest=$VENDOR_MANIFEST" > "$OUTPUT"
    exit 0
fi
[[ "$RELEASE_VERSION" != *[[:space:]]* && -n "$RELEASE_VERSION" ]]
[[ "$SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]]
[[ "$REPOSITORY" != *[[:space:]]* && -n "$REPOSITORY" ]]
[[ "$FROM_TAG" =~ ^refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$ ]]
[[ "$TO_TAG" =~ ^refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$ ]]
[[ "$TRUST_POLICY" =~ ^[0-9a-f]{64}$ && "$VENDOR_MANIFEST" =~ ^[0-9a-f]{64}$ ]]
[[ "$OUTPUT" != *$'\n'* && -n "$OUTPUT" ]]
echo "release signer contract ready: ${RELEASE_VERSION} ${SOURCE_COMMIT}"
