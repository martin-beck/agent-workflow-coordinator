#!/usr/bin/env bash
# Public-safe release signer contract template. Rendering and --self-test are
# non-publishing; the rendered script is retained only on the signing runner
# for the job lifetime. No-argument execution is reserved for an authorized signer.
set -euo pipefail
readonly RELEASE_VERSION=@RELEASE_VERSION@
readonly SOURCE_COMMIT=@SOURCE_COMMIT@
readonly REPOSITORY=@REPOSITORY@
readonly FROM_TAG=@FROM_TAG@
readonly TO_TAG=@TO_TAG@
readonly TRUST_POLICY=@TRUST_POLICY@
readonly VENDOR_MANIFEST=@VENDOR_MANIFEST@
readonly OUTPUT=@OUTPUT@
readonly SIGNING_KEY_REF=@SIGNING_KEY_REF@
readonly SIGNING_POLICY_REF=@SIGNING_POLICY_REF@
readonly SIGNING_IDENTITY=@SIGNING_IDENTITY@
readonly SIGNING_KEY_FINGERPRINT=@SIGNING_KEY_FINGERPRINT@
readonly SIGNING_POLICY_DIGEST=@SIGNING_POLICY_DIGEST@
if [[ "${1:-}" != "--self-test" ]]; then
    [[ "$#" -eq 0 ]] || { echo "usage: $0 [--self-test]" >&2; exit 64; }
    test -z "$(git -C "$REPOSITORY" status --porcelain --untracked-files=all)"
    test "$(git -C "$REPOSITORY" config --get user.signingkey)" = "$SIGNING_KEY_REF"
    test "$(git -C "$REPOSITORY" config --get gpg.format)" = ssh
    test "$(git -C "$REPOSITORY" config --get gpg.ssh.allowedSignersFile)" = "$SIGNING_POLICY_REF"
    test "$(git -C "$REPOSITORY" config --get user.email)" = "$SIGNING_IDENTITY"
    test "$(sha256sum "$SIGNING_POLICY_REF" | cut -d' ' -f1)" = "$SIGNING_POLICY_DIGEST"
    test "$(ssh-keygen -lf "$SIGNING_KEY_REF" 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i ~ /^SHA256:/) print $i; exit}')" = "$SIGNING_KEY_FINGERPRINT"
    test "$(git -C "$REPOSITORY" rev-parse HEAD)" = "$SOURCE_COMMIT"
    test -n "$(git -C "$REPOSITORY" diff --cached --name-only)"
    git -C "$REPOSITORY" tag --verify "${FROM_TAG#refs/tags/}"
    test -z "$(git -C "$REPOSITORY" tag --list "${TO_TAG#refs/tags/}")"
    git -C "$REPOSITORY" commit -S -m "Release $RELEASE_VERSION"
    source_commit="$(git -C "$REPOSITORY" rev-parse HEAD)"
    git -C "$REPOSITORY" tag -s "${TO_TAG#refs/tags/}" -m "Release $RELEASE_VERSION" "$source_commit"
    git -C "$REPOSITORY" verify-tag "${TO_TAG#refs/tags/}"
    tag_object="$(git -C "$REPOSITORY" rev-parse "${TO_TAG}^{tag}")"
    printf '{"from":"%s","to":"%s","source_commit":"%s","tag_object":"%s","trust_policy":"%s","vendor_manifest":"%s"}\n' \
        "$FROM_TAG" "$TO_TAG" "$source_commit" "$tag_object" \
        "$TRUST_POLICY" "$VENDOR_MANIFEST" > "$OUTPUT"
    exit 0
fi
[[ "$RELEASE_VERSION" != *[[:space:]]* && -n "$RELEASE_VERSION" ]]
[[ "$SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]]
[[ "$REPOSITORY" != *[[:space:]]* && -n "$REPOSITORY" ]]
[[ "$FROM_TAG" =~ ^refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$ ]]
[[ "$TO_TAG" =~ ^refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$ ]]
[[ "$TRUST_POLICY" =~ ^[0-9a-f]{64}$ && "$VENDOR_MANIFEST" =~ ^[0-9a-f]{64}$ ]]
[[ "$OUTPUT" != *$'\n'* && -n "$OUTPUT" ]]
[[ -n "$SIGNING_KEY_REF" && "$SIGNING_KEY_REF" != *$'\n'* ]]
[[ -n "$SIGNING_POLICY_REF" && "$SIGNING_POLICY_REF" != *$'\n'* ]]
[[ -r "$SIGNING_POLICY_REF" ]]
[[ -n "$SIGNING_IDENTITY" && "$SIGNING_IDENTITY" != *$'\n'* ]]
[[ "$SIGNING_KEY_FINGERPRINT" =~ ^SHA256:[A-Za-z0-9+/=]+$ ]]
[[ "$SIGNING_POLICY_DIGEST" =~ ^[0-9a-f]{64}$ ]]
echo "release signer contract self-test passed"
